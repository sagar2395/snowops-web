---
interface Props {
  value: string;
  label: string;
  tone?: 'light' | 'dark';
}

const { value, label, tone = 'light' } = Astro.props;

const valueColor = tone === 'dark' ? 'text-snow-50' : 'text-ink-900';
const labelColor = tone === 'dark' ? 'text-slate-400' : 'text-slate-500';
const border = tone === 'dark' ? 'border-ink-800' : 'border-snow-200';
---

<div class={`border-t ${border} pt-6`}>
  <p class={`font-mono text-4xl font-medium tracking-tight ${valueColor}`}>{value}</p>
  <p class={`mt-3 mono-label ${labelColor}`}>{label}</p>
</div>
