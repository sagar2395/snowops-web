---
import { Icon } from 'astro-icon/components';

interface Props {
  initials: string;
  name: string;
  role: string;
  bio: string;
  focus: string[];
  links?: { label: string; href: string; icon: string }[];
}

const { initials, name, role, bio, focus, links = [] } = Astro.props;
---

<article class="border border-snow-200 bg-white p-8 sm:p-10">
  <div class="flex items-start justify-between gap-6">
    <span class="grid h-20 w-20 place-items-center border border-ink-900 bg-ink-900 font-mono text-2xl font-semibold tracking-tight text-snow-50">
      {initials}
    </span>
    {
      links.length > 0 && (
        <div class="flex items-center gap-1">
          {links.map((l) => (
            <a
              href={l.href}
              class="grid h-9 w-9 place-items-center border border-snow-200 text-slate-500 transition-colors hover:border-ink-900 hover:text-ink-900"
              aria-label={l.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={l.icon} class="h-4 w-4" />
            </a>
          ))}
        </div>
      )
    }
  </div>

  <h2 class="mt-7 text-2xl font-semibold tracking-tight text-ink-900">{name}</h2>
  <p class="mt-1 mono-label text-glacier-500">{role}</p>

  <p class="mt-6 text-base leading-relaxed text-slate-700">{bio}</p>

  <div class="mt-8 border-t border-snow-200 pt-6">
    <p class="mono-label text-slate-500">Focus areas</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        focus.map((f) => (
          <li class="border border-snow-200 bg-snow-50 px-3 py-1.5 font-mono text-xs text-ink-900">{f}</li>
        ))
      }
    </ul>
  </div>
</article>
