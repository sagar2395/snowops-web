---
import { Icon } from 'astro-icon/components';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  id: string;
  number: string;
  icon: string;
  title: string;
  summary: string;
  bullets: string[];
  outcomes: string;
  reverse?: boolean;
}

const { id, number, icon, title, summary, bullets, outcomes, reverse = false } = Astro.props;
---

<article id={id} class="grid scroll-mt-24 gap-12 py-16 lg:grid-cols-12 lg:gap-16 border-b border-snow-200 last:border-0">
  <div class:list={['lg:col-span-7', reverse && 'lg:order-2']}>
    <Eyebrow>{number}</Eyebrow>
    <div class="mt-4 flex items-center gap-3">
      <span class="grid h-10 w-10 place-items-center border border-snow-200 bg-snow-50 text-glacier-500">
        <Icon name={icon} class="h-5 w-5" />
      </span>
      <h2 class="text-2xl font-semibold tracking-tight text-ink-900 sm:text-3xl">{title}</h2>
    </div>
    <p class="mt-6 text-lg leading-relaxed text-slate-600">{summary}</p>

    <ul class="mt-8 grid gap-x-8 gap-y-3 sm:grid-cols-2">
      {
        bullets.map((b) => (
          <li class="flex gap-3 text-sm leading-relaxed text-slate-700">
            <Icon name="lucide:check" class="mt-1 h-3.5 w-3.5 shrink-0 text-glacier-500" />
            <span>{b}</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 border-t border-snow-200 pt-5 mono-label text-slate-500">
      Outcome → <span class="text-ink-900">{outcomes}</span>
    </p>
  </div>

  <div class:list={['lg:col-span-5', reverse && 'lg:order-1']}>
    <slot />
  </div>
</article>
