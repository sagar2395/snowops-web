---
import Container from '../layout/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { Icon } from 'astro-icon/components';

const props = [
  {
    eyebrow: '01 · Automation first',
    icon: 'lucide:terminal',
    title: 'Code and pipelines, not runbooks.',
    body:
      'Every change we ship is reproducible, versioned, and reviewed. We don\'t hand you a checklist — we hand you a repo that enforces itself.',
  },
  {
    eyebrow: '02 · Security by default',
    icon: 'lucide:shield-check',
    title: 'Zero-trust embedded at day one.',
    body:
      'Least-privilege IAM, signed builds, workload identity, secret rotation — wired into the platform before the first workload runs.',
  },
  {
    eyebrow: '03 · Compliance as code',
    icon: 'lucide:file-check',
    title: 'Controls live in the pipeline.',
    body:
      'SOC 2 and ISO 27001 controls are policy, not PDFs. Evidence is collected continuously. Audits become a one-click export.',
  },
];
---

<section class="border-b border-snow-200 bg-white">
  <Container>
    <div class="grid gap-12 py-20 md:grid-cols-3 md:gap-8">
      {
        props.map((p) => (
          <div class="flex flex-col">
            <div class="flex items-center gap-3">
              <span class="grid h-9 w-9 place-items-center border border-snow-200 bg-snow-50 text-ink-900">
                <Icon name={p.icon} class="h-4 w-4" />
              </span>
              <Eyebrow>{p.eyebrow}</Eyebrow>
            </div>
            <h3 class="mt-6 text-xl font-semibold leading-snug tracking-tight text-ink-900">
              {p.title}
            </h3>
            <p class="mt-3 text-base leading-relaxed text-slate-600">{p.body}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
