---
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';

const capabilities = [
  {
    icon: 'lucide:layers',
    title: 'Terraform & IaC',
    body: 'Versioned module libraries, drift detection, state hygiene. Production-grade from the first commit.',
    href: '/services#terraform',
  },
  {
    icon: 'lucide:box',
    title: 'Kubernetes / EKS',
    body: 'Hardened clusters with GitOps. Workload identity, network policy, multi-tenant by design.',
    href: '/services#kubernetes',
  },
  {
    icon: 'lucide:git-branch',
    title: 'CI/CD Governance',
    body: 'Signed builds, environment promotion, change approvals enforced in code — not in tickets.',
    href: '/services#cicd',
  },
  {
    icon: 'lucide:scroll-text',
    title: 'Policy as Code',
    body: 'OPA, Kyverno, Conftest. SOC 2 and ISO 27001 controls embedded in the pipeline.',
    href: '/services#policy-as-code',
  },
];
---

<section class="border-b border-snow-200 bg-snow-50">
  <Container>
    <div class="flex flex-col gap-10 py-20 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        eyebrow="Capabilities"
        title="The four pillars we build on."
        description="Four disciplines, one operating model. Every engagement combines them — no à la carte gaps left to your team to bridge."
      />
      <Button href="/services" variant="link" icon="lucide:arrow-right">
        Explore the full surface
      </Button>
    </div>

    <div class="grid gap-px border border-snow-200 bg-snow-200 sm:grid-cols-2 lg:grid-cols-4">
      {
        capabilities.map((c) => (
          <a
            href={c.href}
            class="group flex flex-col gap-5 bg-white p-8 transition-colors hover:bg-snow-50"
          >
            <span class="grid h-10 w-10 place-items-center border border-snow-200 bg-snow-50 text-glacier-500 transition-colors group-hover:border-glacier-500">
              <Icon name={c.icon} class="h-5 w-5" />
            </span>
            <h3 class="text-lg font-semibold tracking-tight text-ink-900">{c.title}</h3>
            <p class="text-sm leading-relaxed text-slate-600">{c.body}</p>
            <span class="mono-label mt-auto inline-flex items-center gap-1 text-slate-500 transition-colors group-hover:text-glacier-500">
              Read more <Icon name="lucide:arrow-up-right" class="h-3 w-3" />
            </span>
          </a>
        ))
      }
    </div>

    <div class="py-20" />
  </Container>
</section>
