---
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { Image } from 'astro:assets';
import diagram from '../../assets/diagrams/delivery-process.svg';
---

<section class="border-b border-ink-800 bg-ink-900">
  <Container>
    <div class="grid gap-12 py-20 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Operating model"
          title="A seven-phase delivery model. Engineered, not improvised."
          description="Every engagement runs the same disciplined path — from scoped discovery to a live, audit-ready handover. Two-week sprints, ending in a working demo."
          tone="dark"
        />
        <div class="mt-10">
          <Button href="/process" variant="ghost" class="border-snow-200/20 text-snow-50 hover:border-glacier-300">
            Walk the full process
          </Button>
        </div>
      </div>

      <div class="lg:col-span-7">
        <figure class="border border-ink-800 bg-ink-950 p-6">
          <figcaption class="mb-4 flex items-center justify-between border-b border-ink-800 pb-3">
            <span class="mono-label text-slate-400">delivery.timeline</span>
            <span class="mono-label text-glacier-300">on track</span>
          </figcaption>
          <Image src={diagram} alt="SnowOps seven-phase delivery model: Discovery, Contract, Onboard, Delivery, Compliance QA, Handover, Support." class="h-auto w-full" />
        </figure>
      </div>
    </div>
  </Container>
</section>
